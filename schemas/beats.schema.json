{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beats.schema.json",
  "title": "beats.yaml",
  "description": "A production's beats, written at stage 2 (docs/project-definition.md §Pipeline). Formalized early, in M1, so stage 4 can read hand-written fixtures before stage 2 exists (rollout Input Gaps). Times are absolute seconds from the film's start; unique ids and contiguous timing are checked by validators. Changes after M1 need an ADR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "production_id", "beats"],
  "properties": {
    "schema_version": { "$ref": "_defs.schema.json#/$defs/schema_version", "const": 1 },
    "production_id": { "$ref": "_defs.schema.json#/$defs/production_id" },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_s", "duration_s", "change", "narration", "sound_cues"],
        "properties": {
          "id": { "$ref": "_defs.schema.json#/$defs/beat_id" },
          "start_s": { "$ref": "_defs.schema.json#/$defs/seconds" },
          "duration_s": { "$ref": "_defs.schema.json#/$defs/positive_seconds" },
          "change": {
            "description": "The one change in situation or emotion this beat is (docs/glossary.md \"Beat\").",
            "type": "string",
            "minLength": 1
          },
          "narration": { "$ref": "_defs.schema.json#/$defs/narration" },
          "sound_cues": { "$ref": "_defs.schema.json#/$defs/sound_cues" }
        }
      }
    }
  }
}
